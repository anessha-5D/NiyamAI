{
  "name": "niyamai-text-audit-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API and hybrid audit engine for NiyamAI Text Audit",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/config', {recursive:true}); fs.copyFileSync('src/config/brandProfile.json', 'dist/config/brandProfile.json');\"",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.5",
    "diff": "^8.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/diff": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
